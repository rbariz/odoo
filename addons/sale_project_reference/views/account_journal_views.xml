<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_journal_code_label" model="ir.ui.view">
        <field name="name">account.journal.form.journal.code.label</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']"
                   position="attributes">
                <attribute name="string">Journal Code</attribute>
            </xpath>
        </field>
    </record>
</odoo>