<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_customer_intervention_document">

        <t t-call="web.external_layout">
            <div class="page" style="font-family: Arial, sans-serif;">
                <h2>
                    <span t-if="doc.state == 'draft'">Draft Intervention Sheet</span>
                    <span t-elif="doc.state == 'confirmed'">Confirmed Intervention Sheet</span>
                    <span t-else="">Cancelled Intervention Sheet</span>
                </h2>

                <div class="mb-3">
                    <strong style="font-weight: 700;">Customer</strong>
                    <div t-field="doc.partner_id"
                        t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                </div>

                <style>
                    table.intervention-details > tbody > tr > th {
                        padding-left: 12px !important;
                    }
                </style>

                <table class="table table-sm table-bordered intervention-details">
                    <tbody>
                        <tr>
                            <th scope="row" style="width: 30%;">Subject</th>
                            <td>
                                <span t-field="doc.name"/>
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">Status</th>
                            <td>
                                <span t-field="doc.state"/>
                            </td>
                        </tr>

                        <tr>
                            <th scope="row">Reference</th>
                            <td>
                                Intervention-<span t-out="doc.id"/>
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">Created On</th>
                            <td>
                                <span t-field="doc.create_date"
                                    t-options='{"widget": "date"}'/>
                            </td>
                        </tr>

                        <t t-if="doc.equipment_id">
                            <tr>
                                <th scope="row">Equipment Code</th>
                                <td>
                                    <span t-field="doc.equipment_id.code"/>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">Equipment Name</th>
                                <td>
                                    <span t-field="doc.equipment_id.name"/>
                                </td>
                            </tr>
                        </t>
                        <tr t-else="">
                            <th scope="row">Equipment</th>
                            <td>No equipment selected.</td>
                        </tr>
                    </tbody>
                </table>


                <div t-if="doc.equipment_id">
                    <h3>Equipment Interventions</h3>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Reference</th>
                                <th>Subject</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.equipment_id.intervention_ids.sorted('id')"
                            t-as="intervention">
                                <tr t-att-style="'font-weight: bold;' if intervention.id == doc.id else ''">
                                    <td><span t-out="intervention_index + 1"/></td>
                                    <td>Intervention-<span t-out="intervention.id"/></td>
                                    <td><span t-field="intervention.name"/></td>
                                    <td><span t-field="intervention.state"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="report_customer_intervention">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="customer_equipment_service.report_customer_intervention_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_customer_intervention"
            model="ir.actions.report">
        <field name="name">Intervention Sheet</field>
        <field name="model">customer.intervention</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_equipment_service.report_customer_intervention</field>
        <field name="print_report_name">'Intervention-%s' % object.id</field>
        <field name="binding_model_id"
               ref="model_customer_intervention"/>
        <field name="binding_type">report</field>
    </record>
</odoo>